{
  "name": "guillermo",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberately small, local coding agent for learning.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run clean && npm run build && node --test dist/**/*.test.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
