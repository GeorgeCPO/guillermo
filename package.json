{
  "name": "guillermo",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberately small, local coding agent for learning.",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "clean:test": "rm -rf dist-test",
    "dev": "tsx src/index.ts",
    "dev:webhooks": "npm run dev",
    "start": "node dist/index.js",
    "start:webhooks": "npm start",
    "cli": "tsx src/entrypoints/cli/main.ts",
    "start:cli": "node dist/entrypoints/cli/main.js",
    "docker:build": "docker build --file Dockerfile.worker --tag guillermo-worker:latest .",
    "docker:build:coordinator": "docker build --file Dockerfile.coordinator --tag guillermo-coordinator:local .",
    "test": "npm run clean:test && tsc -p tsconfig.test.json && node --test 'dist-test/tests/**/*.test.js'",
    "check": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "fastify": "^5.12.1",
    "openai": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  }
}
