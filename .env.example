# Required to run Guillermo against the OpenAI Responses API.
OPENAI_API_KEY=

# Optional. Choose any Responses-API model that supports function calling.
GUILLERMO_MODEL=gpt-5.6-terra

# Optional. Must be an integer from 1 through 50.
GUILLERMO_MAX_STEPS=20

# Required only for the Jira webhook server. Use a random value of at least 16 bytes.
GUILLERMO_JIRA_WEBHOOK_SECRET=

# Required only for the Jira webhook server. This single-line JSON object is the
# server-owned allowlist. Repositories use GitHub owner/name identities;
# prTitleFormat is optional and supports only {issueKey} and {summary}.
GUILLERMO_JIRA_PROJECTS={"APP":{"repository":"my-org/app","baseBranch":"main","prTitleFormat":"[{issueKey}] {summary}"}}

# Required only for the Jira webhook server. IDs come from the installed GitHub
# App. The private key is read from this absolute file path and is never copied
# into a checkout or passed to repository-controlled commands.
GUILLERMO_GITHUB_APP_ID=
GUILLERMO_GITHUB_APP_INSTALLATION_ID=
GUILLERMO_GITHUB_APP_PRIVATE_KEY_PATH=

# Commit identity used by unattended webhook jobs.
GUILLERMO_GIT_AUTHOR_NAME=
GUILLERMO_GIT_AUTHOR_EMAIL=

# Required for webhook deployments. It must be a normalized absolute path and
# must be bind-mounted at the identical path when the coordinator is containerized.
GUILLERMO_WORKSPACE_ROOT=/var/lib/guillermo/workspaces

# Stage 10 Docker sandbox settings for unattended repository-controlled commands.
# Build the default image with `npm run docker:build` before starting the server.
GUILLERMO_DOCKER_IMAGE=guillermo-worker:latest
GUILLERMO_DOCKER_MEMORY=1g
GUILLERMO_DOCKER_CPUS=2
GUILLERMO_DOCKER_PIDS=256

# Optional webhook listener settings. The loopback default is safest for local use.
GUILLERMO_WEBHOOK_HOST=127.0.0.1
GUILLERMO_WEBHOOK_PORT=3000
